---
import Navbar from "@/components/navigation/Navigation.astro";
const { pageTitle, blogTitle, metaDescription, metaTitle } = Astro.props;
const currentPath =
  Astro.url.pathname.slice(-1) === "/" && Astro.url.pathname.length > 1
    ? Astro.url.pathname.slice(0, -1)
    : Astro.url.pathname;

const siteTitle = "iaaron — physicist, developer & artist";
const title =
  metaTitle ||
  (blogTitle
    ? `${blogTitle} | iaaron`
    : pageTitle
      ? `${pageTitle} | iaaron`
      : siteTitle);
const description =
  metaDescription ||
  "Portfolio of Aaron — physicist, developer, and artist blending science, art, and technology.";
// canonical URL — built from the `site` set in astro.config.mjs
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

import "../styles/global.css";
---

<html lang="en">
  <head>
    <!-- Prevent Flash of Unstyled Content (FOUC)  -->
    <script>
      if (
        localStorage.theme === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/kb16.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="iaaron" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>

  <body class="flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-2 focus:bg-white focus:text-black"
      >Skip to content</a
    >
    <!-- Navigation Bar -->
    <Navbar currentPath={currentPath} />

    <!-- Main content -->
    <main id="main-content" class="w-full flex flex-col items-center">
      <!-- show current path -->
      {currentPath !== "/" && <p class="mb-2 self-start">{currentPath}</p>}

      <!-- Titles: Renders bases if it's for a page title or blog title -->
      {pageTitle && <h1>{pageTitle}</h1>}
      {
        blogTitle && (
          <h1 class="text-5xl md:text-6xl md:mt-24 capitalize lg:w-2/3">
            {blogTitle}
          </h1>
        )
      }

      <!-- Content -->
      <slot />
    </main>
  </body>

  <!-- Styles -->
  <style is:global>
    /* global styles */
    * {
      box-sizing: border-box;
      /* outline: 1px solid red; */
    }
    html,
    body {
      height: 100vh;
      width: 100%;
      margin: 0;
    }
    body {
      @apply font-redditmono-regular bg-slate-100 dark:bg-night dark:text-slate-100;
    }
    /* component classes */
    nav {
      @apply p-4 w-full flex justify-center;
    }
    nav a:hover {
      @apply text-black dark:text-white;
    }
    main {
      @apply border-none w-full p-10 lg:px-24 xl:px-64;
    }
    h2,
    h3,
    h4,
    h5,
    h6 {
      @apply font-redditmono-bold mt-6 mb-2;
    }
    h1 {
      @apply font-redditmono-bold mb-10 text-6xl md:text-8xl;
    }
    h2 {
      @apply leading-normal text-2xl md:text-4xl;
    }
    h3 {
      @apply text-2xl;
    }
    p {
      @apply text-slate-500 text-sm dark:text-slate-400;
    }
    a {
      @apply font-redditmono-regular text-blue-600 hover:text-slate-900 dark:text-sky-400 dark:hover:text-white;
    }
    button,
    .btn {
      @apply bg-slate-300 px-3 py-1 rounded-md dark:bg-slate-600;
    }

    .btn-line {
      @apply border rounded-md border-slate-500 hover:bg-blue-600 hover:text-white hover:border-transparent dark:border-slate-500 dark:hover:bg-blue-700 dark:hover:border-transparent;
    }
    .navbar-link {
      @apply text-slate-500 dark:text-slate-400;
    }
    .navbar-link-active {
      @apply font-bold text-black no-underline dark:text-white;
    }
    .navbar-content {
      @apply hidden md:flex md:flex-row md:items-center md:space-x-6;
    }
    .navbar-show {
      @apply flex flex-col items-center w-full h-full z-30 absolute left-0 top-0 py-20 bg-white dark:bg-night;
    }
    .navbar-show a {
      @apply text-4xl my-4;
    }
    .navbar-show span,
    .navbar-show p {
      @apply text-4xl mb-4 mt-10 text-slate-400 dark:text-slate-500;
    }
    .navbar-show button {
      @apply text-4xl;
    }

    /* Accessibility */
    .sr-only {
      @apply absolute w-px h-px p-0 -m-px overflow-hidden whitespace-nowrap;
      clip: rect(0, 0, 0, 0);
      border: 0;
    }

    /* Bot protection — obfuscate contact info */
    .contact-email {
      unicode-bidi: bidi-override;
      direction: rtl;
    }
  </style>

  <!-- scripts -->
  <script>
    import "../scripts/themeToggle";
    import "../scripts/navbarToggle";
  </script>
</html>
