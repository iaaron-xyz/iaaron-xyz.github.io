---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectsSection from "@/components/projects/ProjectsSection.astro";
const pageTitle = "Data Science and Data Analytics";
const projectCategory = "data-science";
const metaDescription = "Data science and data analytics projects by Aaron — analysis, visualization, and turning data into clear insights.";
---

<BaseLayout pageTitle={pageTitle} metaDescription={metaDescription}>
  <section class="aboutpage w-full md:w-2/4">
    <p class="my-8">
      Projects focused on analysis, visualization, and turning data into clear
      insights.
    </p>
  </section>
  <ProjectsSection projectCategory={projectCategory} />
</BaseLayout>
