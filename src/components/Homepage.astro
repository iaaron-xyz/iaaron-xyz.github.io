<section class="homepage w-full flex flex-col">
  <!-- Subtitle -->
  <div class="text-slate-500 dark:text-slate-300">
    <h3 data-scramble class="ml-auto">
      I live happily at the intersection of science, art, and technology.
    </h3>
    <p class="mt-10">
      Hi, I'm Aaron — a physicist, developer, and artist passionate about
      blending science, art, and technology. Welcome to my personal site, from
      data science and physics simulations to creative coding and 3D art, here
      you'll find a collection of my professional and personal projects.
    </p>
    <p class="mt-4">
      I'm currently open to work on remote roles, but I'm also open to hybrid
      arrangements and relocation for the right opportunity.
    </p>
    <p class="mt-4">Let's connect and bring ideas to life — together!</p>
  </div>

  <!-- Socials -->
  <ul class="flex mt-20 ml-auto items-center">
    <li>
      <a
        href="https://github.com/iaaron-xyz"
        target="_blank"
        rel="noopener noreferrer"
        class="mr-6">Github</a
      >
    </li>
    <!-- Replace "yourprofile" with your real LinkedIn handle -->
    <li>
      <a
        href="https://www.linkedin.com/in/yourprofile"
        target="_blank"
        rel="noopener noreferrer"
        class="mx-6">LinkedIn</a
      >
    </li>
    <!-- Bot-protected email: the address below is RTL-reversed in source and assembled at runtime -->
    <li>
      <a id="contact-email" href="#" rel="noopener noreferrer" class="mx-6">
        <span class="contact-email">zyx.noraia&#64;tcatnoc</span>
      </a>
    </li>
  </ul>
</section>

<script>
  const emailUser = "contact";
  const emailDomain = "iaaron.xyz";
  const email = emailUser + "@" + emailDomain;
  const emailLink = document.getElementById("contact-email");
  const emailText = document.querySelector(".contact-email");
  if (emailLink) {
    emailLink.href = "mailto:" + email;
    emailLink.setAttribute("aria-label", "Email me at " + email);
  }
  if (emailText) emailText.textContent = email;
</script>
