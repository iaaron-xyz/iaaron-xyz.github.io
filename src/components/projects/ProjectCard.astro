---
const {
  projectTitle,
  projectDescription,
  projectThumbnail,
  projectRepository,
  projectSite,
  projectTags,
} = Astro.props;

const hasRepository = Boolean(projectRepository?.trim());
const hasSite = Boolean(projectSite?.trim());
---

<div
  class="h-full w-full min-w-0 rounded-xl border border-white/10 bg-white/5 p-3 shadow-sm backdrop-blur-sm"
>
  <!-- Top title -->
  <div class="flex flex-col gap-2 md:flex-row md:items-start">
    <h3 class="text-base font-semibold">{projectTitle}</h3>
    <div class="ml-auto flex flex-wrap gap-2">
      {
        hasRepository && (
          <a href={projectRepository} class="px-2 py-1 btn-line">
            GITHUB
          </a>
        )
      }
      {
        hasSite && (
          <a href={projectSite} target="_blank" class="px-2 py-1 btn-line">
            LIVE DEMO
          </a>
        )
      }
    </div>
  </div>

  <!-- Thumbnail -->
  {
    hasSite ? (
      <a href={projectSite} target="_blank">
        <div class="mt-4 overflow-hidden rounded-md">
          <img
            src={projectThumbnail}
            alt=""
            class="h-36 sm:h-40 md:h-44 w-full object-cover rounded-md transform transition-transform duration-300 hover:scale-110"
          />
        </div>
      </a>
    ) : (
      <div class="mt-4 overflow-hidden rounded-md">
        <img
          src={projectThumbnail}
          alt=""
          class="h-36 sm:h-40 md:h-44 w-full object-cover rounded-md"
        />
      </div>
    )
  }

  <!-- Description -->
  <p class="mt-3 text-sm leading-6">{projectDescription}</p>
  <div class="mt-3 flex flex-wrap gap-2 text-sm">
    {
      projectTags.map((tag) => (
        <span
          class="px-2 py-1 rounded-md"
          style={`background:${tag.bgColor}; color:${tag.textColor}`}
        >
          {tag.name}
        </span>
      ))
    }
  </div>
</div>
