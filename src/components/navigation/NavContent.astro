---
const { currentPath } = Astro.props;
---

<!-- Pages -->
<div class="navbar-content flex flex-col items-center">
  <a href="/" class={currentPath === "/" ? "navbar-link-active" : "navbar-link"}
    >Home</a
  >
  <a
    href="/about"
    class={currentPath === "/about" ? "navbar-link-active" : "navbar-link"}
    >About</a
  >
  <a
    href="/projects"
    class={currentPath === "/projects" ? "navbar-link-active" : "navbar-link"}
    >Projects</a
  >
  <div class="mt-10 md:mt-0">
    <button id="theme-toggle" aria-label="Toggle dark mode"> M </button>
  </div>
</div>
